{
  "name": "tifl-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "tifl SolidJS client — compiled by esbuild, served by the Go server.",
  "scripts": {
    "api:types": "openapi-typescript ../spec/openapi.yaml -o src/api-types.ts",
    "api:types:check": "openapi-typescript ../spec/openapi.yaml -o src/api-types.ts --check",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "npm run api:types:check && tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.6.0",
    "openapi-typescript": "^7.13.0",
    "solid-js": "^1.9.3",
    "typescript": "^5.7.2"
  }
}
