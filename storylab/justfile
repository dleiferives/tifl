# storylab manual setup — things pip can't install on its own.
#
# After `pip install -e '.[lab]'` (or .[dev]) from the repo root, run `just setup`
# here once. It fetches the spaCy Greek model, the Greek frequency list, and
# builds the lemma->rank cache the at-level metrics need.

freq_url := "https://raw.githubusercontent.com/hermitdave/FrequencyWords/master/content/2018/el/el_50k.txt"
vocab_dir := justfile_directory() / "vocab"
root := justfile_directory() / ".."

# list available recipes
default:
    @just --list

# full setup: lab deps + spaCy Greek model + frequency list + lemma cache
setup: deps model freq lemma-cache
    @echo "storylab setup complete — try: cd {{root}} && python -m storylab run"

# install the harness's Python deps (jinja2, pyyaml, spacy)
deps:
    cd {{root}} && pip install -e '.[lab]'

# download the spaCy Greek model (~15 MB) used for lemmatization
model:
    python -m spacy download el_core_news_sm

# download the Greek frequency list (MIT — hermitdave/FrequencyWords, OpenSubtitles)
freq:
    mkdir -p {{vocab_dir}}
    curl -sSL --max-time 120 -o {{vocab_dir}}/el_50k.txt "{{freq_url}}"
    @echo "frequency list:" && wc -l {{vocab_dir}}/el_50k.txt

# build the lemma->frequency-rank cache (needs the spaCy model; ~30 s)
lemma-cache:
    cd {{root}} && python -c "from storylab import vocab; print('lemma ranks cached:', len(vocab.ranks()))"

# remove downloaded / generated vocab artifacts (re-create with `just freq lemma-cache`)
clean-vocab:
    rm -f {{vocab_dir}}/el_50k.txt {{vocab_dir}}/el_lemma_rank.json
