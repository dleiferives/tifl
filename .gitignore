# Go build output
/bin/
*.test
*.out
coverage.txt

# Web (see web/.gitignore too)
/web/node_modules/
/web/dist/

# Local data & logs — never committed
/data/
/ai_logs/
*.db

# Local config — copy tifl.config.example.yaml to tifl.yaml and edit
/tifl.yaml
.env
.env.*

# Agent prompt/patch scratch space — never committed
/tmp/

# Editors / OS
.DS_Store
*.swp
/scripts/__pycache__
/eval/**/__pycache__
/greek_bench_out.txt
# Eval runs: raw generation output is large and rerunnable; only curated
# result JSONs under eval/results/ are committed deliberately.
/eval/results/run*.json
